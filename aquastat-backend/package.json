{
  "name": "aquastat-backend",
  "version": "1.0.0",
  "description": "AquaStat — Water Supply Forecasting & Decision Support API",
  "author": "AquaStat Team",
  "license": "MIT",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "db:migrate": "ts-node -r tsconfig-paths/register src/database/migrate.ts",
    "db:migrate:constellation": "ts-node -r tsconfig-paths/register src/database/migrate_constellation.ts",
    "db:seed:constellation": "ts-node -r tsconfig-paths/register src/database/seed_constellation.ts",
    "db:inspect": "ts-node -r tsconfig-paths/register src/database/inspect_tables.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "uuid": "^11.1.1",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.11",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
